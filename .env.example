# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN:priority, one entry per car, comma-separated.
# Lower priority number = charges first. Priority is optional and defaults
# to the order listed (first listed charges first).
TCC_VEHICLES=Daily=5YJ3E1EA0KF000001:1,Second=7SAYGDEE5PF000002:2

# --- Charging behavior ---------------------------------------------------
# Target state of charge (%) for every vehicle
TCC_TARGET_SOC=80
# How often the coordinator checks the fleet (seconds)
TCC_POLL_INTERVAL_SECONDS=300
# Optional off-peak window (HH:MM, 24h). Outside it, nothing charges.
# Leave both empty to allow charging at any time.
TCC_OFFPEAK_START=22:00
TCC_OFFPEAK_END=06:00
# If you manually start charging a car from the app/screen, the coordinator
# backs off instead of fighting you. Set to false to always enforce.
TCC_RESPECT_MANUAL_OVERRIDE=true
# Dry run: log what WOULD happen without sending any commands to the cars.
# Great for testing your setup safely.
TCC_DRY_RUN=false
